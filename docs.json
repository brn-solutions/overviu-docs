{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Overviu",
  "description": "Guides for hosts and the API reference for Overviu, the property management platform for holiday rentals.",
  "colors": {
    "primary": "#65A30D",
    "light": "#A3E635",
    "dark": "#4D7C0F"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.overviu.app"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/quickstart",
              "get-started/key-ideas"
            ]
          },
          {
            "group": "Listings",
            "pages": [
              "listings/create-a-listing",
              "listings/buildings-and-units",
              "listings/photos-and-listing-page",
              "listings/address-and-map",
              "listings/trash-and-restore"
            ]
          },
          {
            "group": "Calendar & pricing",
            "pages": [
              "calendar/the-calendar",
              "calendar/prices-and-rules",
              "calendar/blocking-dates",
              "calendar/booking-site-calendars"
            ]
          },
          {
            "group": "Bookings",
            "pages": [
              "bookings/bookings-and-statuses",
              "bookings/create-a-booking",
              "bookings/change-a-booking",
              "bookings/cancel-and-refund",
              "bookings/record-a-payment"
            ]
          },
          {
            "group": "Payments",
            "pages": [
              "payments/connect-stripe",
              "payments/how-guests-pay",
              "payments/security-deposits",
              "payments/refunds",
              "payments/coupons"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/conventions"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Sign in",
        "href": "https://overviu.app/login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Overviu",
      "href": "https://overviu.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Overviu",
        "items": [
          {
            "label": "Open Overviu",
            "href": "https://overviu.app"
          },
          {
            "label": "API reference",
            "href": "/api-reference/introduction"
          }
        ]
      }
    ]
  }
